            <slice size="10" color="#ffffffff">If you like it — use it, if not — delete it.</slice>
            <slice break="true"></slice>
            <slice size="10" color="#ffffffff">If you encounter any issues while using, contact me for fixes, github: slakkystar</slice>
        </slices>
    </text>
</group>