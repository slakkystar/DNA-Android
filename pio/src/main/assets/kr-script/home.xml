<?xml version="1.0" encoding="UTF-8" ?>
<resource dir="file:///android_asset/samples" /> 
<group>
    <action auto-off="true">
          <title>Выбрать проект</title>
          <set>echo $TSL > $TMPDIR/DNA.ini</set>
          <summary sh="echo 'Текущий проект: /sdcard/DNA' ;cat $TMPDIR/DNA.ini"/>          
          <param name="TSL" options-sh="samples/project.sh CK" required="true"/>
    </action>
   
    <action reload="true" auto-off="true">
           <title>Удалить проект</title>
           <set>samples/project.sh SC</set>
           <param name="TSS"  multiple="true" options-sh="samples/project.sh CK" required="true"/>
    </action>
    
    <action reload="true" auto-off="true">
           <title>Создать проект</title>
           <set>samples/project.sh XJ</set>
           <param name="T" placeholder="Введите название проекта (не используйте китайские символы):" required="true"/>
    </action>

    <page title="Меню проекта" config="file:///android_asset/kr-script/dna.xml">
            <lock>
                if [[ -f $TMPDIR/DNA.ini ]]; then
                    echo 'unlocked'
                else
                    echo 'Сначала создайте проект'
                fi
            </lock>
    </page>
</group>

<group>
    <text>
        <slices>
            <slice size="18" color="#ffffffff">Отказ от ответственности</slice>
            <slice break="true"></slice>
            <slice size="10" color="#ffffffff">Приложение не несёт ответственности за любые непредвиденные последствия для системы. Пользователь полностью отвечает за результат любых действий.</slice>
            <slice break="true"></slice>
            <slice size="10" color="#ffffffff">Нравится — пользуйтесь, не нравится — удаляйте.</slice>
            <slice break="true"></slice>
            <slice size="10" color="#ffffffff">Если возникнут проблемы при использовании, свяжитесь со мной для исправления, github: slakkystar</slice>
        </slices>
    </text>
</group>