<?xml version="1.0" encoding="UTF-8" ?>
<resource dir="file:///android_asset/samples" /> 
<group>
    <action auto-off="true">
          <title>Select Project</title>
          <set>echo $TSL > $TMPDIR/DNA.ini</set>
          <summary sh="echo 'Current project: /sdcard/DNA' ;cat $TMPDIR/DNA.ini"/>          
          <param name="TSL" options-sh="samples/project.sh CK" required="true"/>
    </action>
   
    <action reload="true" auto-off="true">
           <title>Delete Project</title>
           <set>samples/project.sh SC</set>
           <param name="TSS"  multiple="true" options-sh="samples/project.sh CK" required="true"/>
    </action>
    
    <action reload="true" auto-off="true">
           <title>Create Project</title>
           <set>samples/project.sh XJ</set>
           <param name="T" placeholder="Enter project name (do not use Chinese characters):" required="true"/>
    </action>
    
    <action>
           <title>Clear Project</title>
           <set>samples/project.sh RM</set>
    </action>

    <page title="Project Menu" config="file:///android_asset/kr-script/dna.xml">
            <lock>
                if [[ -f $TMPDIR/DNA.ini ]]; then
                    echo 'unlocked'
                else
                    echo 'Please create a project first'
                fi
            </lock>
    </page>
</group>

<group>
    <text>
        <slices>
            <slice size="18" color="#ffffffff">Disclaimer</slice>
            <slice break="true"></slice>
            <slice size="10" color="#ffffffff">The application is not responsible for any unforeseen consequences to the system. The user bears full responsibility for the result of any actions.</slice>
