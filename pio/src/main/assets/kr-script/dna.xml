<?xml version="1.0" encoding="UTF-8" ?>
<resource dir="file:///android_asset/samples" />
<group title="插件功能">
    <page config-sh="samples/modun.sh" title="插件功能" desc="可使用 file.zip2 导入本地插件">
        <option type="file" style="fab" suffix="zip2" auto-off="true" reload="true"/>
    <handler>
        
        dna unzip $file $START_DIR/module
    </handler>
    </page>
</group>

<group title="解包菜单">
    <action interruptible="false">
        <title>解包 payload.bin</title>
        <set>dna dumper --partition "$img" --delete $silence --auto $auto $DNA_PRO/payload.bin</set>
        <param name="silence" label="完成后删除源文件" type="checkbox" />
        <param name="auto" label="自动解包提取的 IMG" type="checkbox" />
        <param name="img" title="请选择要提取的分区，不选则默认全选：" separator="," options-sh="dna dumper --list $DNA_PRO/payload.bin" multiple="true"/>
        <lock>
            if [[ -f $DNA_PRO/payload.bin ]]; then
                echo 'unlocked'
            else
                echo '未找到 payload.bin'
            fi
        </lock>
    </action>
    
    <action interruptible="false">
        <title>解包 br</title>
        <set>dna extract $BR --delete $silence</set>
        <param name="silence" label="完成后删除源文件" type="checkbox" />
        <param name="BR" title="请选择 br 文件：" separator="," options-sh="samples/findfile.sh br" desc="请将您的文件放入 /sdcard/DNA 项目路径中" required="true" multiple="true"/>                
    </action>

    <action interruptible="false">
        <title>解包 dat</title>
        <set>dna extract $DAT --delete $silence</set>
        <param name="silence" label="完成后删除源文件" type="checkbox" />
        <param name="DAT" title="请选择 dat 文件：" separator="," options-sh="samples/findfile.sh dat" desc="请将您的文件放入 /sdcard/DNA 项目路径中" required="true" multiple="true"/>              
    </action>

    <action interruptible="false">
        <title>解包 img</title>
        <set>dna extract $IMG --delete $silence</set>
        <param name="silence" title="完成后删除源文件" label="完成后删除源文件" type="checkbox" />
        <param name="IMG" title="请选择 img 文件：" separator="," options-sh="samples/findfile.sh img" desc="请将您的文件放入 /sdcard/DNA 项目路径中。工具会自动识别 img 格式并进行解包（解包 super 时，仅提取 a 分区文件。）" required="true" multiple="true"/>
    </action>
    <action interruptible="false">
        <title>解包 super</title>
        <set>dna lpunpack --partition "$img" --delete $silence --auto $auto $DNA_PRO/super.img</set>
        <param name="silence" label="完成后删除源文件" type="checkbox" />
        <param name="auto" label="自动解包提取的 IMG" type="checkbox" />
        <param name="img" title="请选择要提取的分区，不选则默认全选：" separator="," options-sh="dna lpunpack --list $DNA_PRO/super.img" multiple="true"/>
        <lock>
            if [[ -f $DNA_PRO/super.img ]]; then
                echo 'unlocked'
            else
                echo '未找到 super.img'
            fi
        </lock>
    </action>    
</group>

<group title="打包菜单">
    <action interruptible="false">
        <title>打包单个分区</title>
        <set>dna repack $IMG_DIR --read $Read --auto $Pack --format $img_type --type $repack_from --br $brze --erofs $erofsze --mode $type --compress $test --delavb $test1 --convert $tool</set>
        <param name="IMG_DIR" options-sh="samples/findfile.sh dir" desc="将自动检测 IMG 打包格式" separator="," required="true" multiple="true"/>
        <param name="tool" label="打包类型">
             <option value="0"> ext4 </option>
             <option value="1"> erofs </option>
             <option value="2"> f2fs </option>
        </param>        
        <param name="Read" label="读写权限" desc="注意：仅在打包为 ext4 时使用"  >
             <option value="1">读写---rw</option>
             <option value="0">只读---ro</option>
        </param>
        <param name="Pack" label="大小" desc="注意：仅在打包为 ext4 时使用" >
             <option value="1" >自动</option>
             <option value="0" >原始大小</option>
        </param>
        <param name="img_type" label="img 格式" desc="注意：仅在打包为 ext4 或 erofs 时使用" >
             <option value="0" >Raw</option>
             <option value="1" >Sparse</option>
        </param>
        <param name="repack_from" label="文件格式" desc="注意：仅在打包为 ext4 或 erofs 时使用" >
             <option value="0" >IMG</option>
             <option value="1" >DAT</option>
             <option value="2" >BR</option>
        </param>
        <param name="brze" label="br 压缩级别" value="3" desc="注意：数值越大，打包过程可能越慢" type="seekbar" max="7" min="1"/>
        <param name="erofsze" label="Erofs(f2fs) 压缩级别" value="8" desc="注意：仅在打包为 Erofs(f2fs) 时使用"  type="seekbar" max="9" min="0"/>
        <param name="type" label="类型" desc="注意：仅在打包为 Erofs 时使用" >
             <option value="lz4hc" >lz4hc</option>
             <option value="lz4" >lz4</option>
             <option value="lzma" >lzma</option>
        </param>
        <param name="test" label="压缩 ext4 img 空间" desc="注意：仅在打包为 ext4 时使用" type="switch" />
        <param name="test1" label="移除 avb 数据加密" desc="注意：此开关会修改 fstab 文件，该操作并非通用，可能会导致无限重启。" type="switch" />
    </action>
    <action interruptible="false">
        <title>打包 super.img</title>
        <set>dna lpmake --type $type --format $from --super_size $size --super_group $super_group $IMG_NAME</set>
        <param name="type" label="类型" >
             <option value="A"> a_only</option>
             <option value="AB"> ab</option>
             <option value="VAB"> virtual_ab</option>
        </param>
        <param name="from" label="格式" >
             <option value="1"> sparse </option>
             <option value="0"> raw </option>
        </param>
        <param name="size" required="true" value="8.5" label="super.img 总大小" desc="输入您的 super img 大小，默认值为 8.5G。"  type="float"/>
        <param name="super_group" required="true" value="qti_dynamic_partitions" label="分区组名称" desc="如果您不知道，请保持默认。" />
        <param name="IMG_NAME" title="请选择要打包的 IMG 文件：" options-sh="samples/findfile.sh img" desc="请将您的文件放入 /sdcard/DNA 项目路径中" separator="," required="true" multiple="true"/>
    </action>
</group>

<group title="格式转换">
    <action interruptible="false">
        <title>img 转 simg</title>
        <set>samples/img_ov_simg.sh</set>
        <param name="IMG" title="请选择 IMG 文件：" separator="," options-sh="samples/findfile.sh img" desc="请将您的文件放入 /sdcard/DNA 项目路径中" required="true" multiple="true"/>
    </action>

    <action interruptible="false">
        <title>img 转 dat, br</title>
        <set>dna convert $IMG --delete $silence --type $from --br $brze</set>
        <param name="silence" title="删除源文件" label="完成后删除源文件" type="checkbox" />
        <param name="from" label="类型" >
             <option value="0" >DAT</option>
             <option value="1" >BR</option>
        </param>
        <param name="brze" required="true" value="3" label="BR 压缩级别" desc="注意：数值越大，打包过程可能越慢" type="seekbar" max="7" min="1"/>
        <param name="IMG" title="请选择 IMG 文件：" separator="," options-sh="samples/findfile.sh img" desc="请将您的文件放入 /sdcard/DNA 项目路径中" required="true" multiple="true"/>              
    </action>

    <action interruptible="false">
        <title>zst-img 转换</title>
        <set>$START_DIR/samples/zstd_img.sh</set>
        <param name="silence" label="删除源文件" type="checkbox" />
        <param name="ZST" title="请选择文件：" 
           options-sh="samples/findfile.sh zst_img" 
           desc="请将您的文件放入 /sdcard/DNA 项目路径中" 
           required="true" multiple="true"/>
        <param name="level" required="true" value="3" label="zstd 压缩级别" desc="注意：数值越大，压缩越慢！" type="seekbar" max="19" min="0"/>
    </action>

    <action>
        <title>合并 Sparse 分段</title>
        <set>$START_DIR/samples/merge_superchunk.sh</set>
        <desc>将分段的 IMG 合并为完整 IMG</desc>
        <param name="silence" label="删除源文件" type="checkbox" />
        <param name="IMG" title="请选择分段的 IMG 文件" 
            options-sh="samples/findfile.sh split_sparse" 
            desc="识别 /sdcard/DNA 项目路径中的文件" 
            required="true" multiple="true"/>
    </action>
</group>